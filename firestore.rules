rules_version = '2';

// =========================================================
// INTRVL Studio — Firestore 安全規則
// ---------------------------------------------------------
// 把這份內容貼到 Firebase Console → Firestore Database → Rules，
// 然後按「Publish」。這些規則跑在 Google 後端，無法被前端繞過。
// =========================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 是否已登入
    function isSignedIn() {
      return request.auth != null;
    }

    // 是否為管理員：admins 集合裡存在一份文件 ID = 自己的 UID
    // （在 Console 手動建立 admins/<你的UID> 即可成為管理員）
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 非空字串、且長度不超過上限
    function validStr(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    // 快速連結寫入驗證：只允許這些欄位、url 必須是 http(s)://
    // （前端 safeUrl() 的後端對應，擋掉 javascript: 等危險協定）
    function validLink() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'desc', 'url', 'category', 'createdAt'])
        && validStr(d.title, 100)
        && d.url is string
        && d.url.size() <= 2000
        && d.url.matches('https?://.*')
        && (!('desc' in d) || (d.desc is string && d.desc.size() <= 300))
        && (!('category' in d) || (d.category in ['project', 'schedule', 'general']))
        && d.createdAt == request.time;
    }

    // 員工資料寫入驗證（staff）：只允許這些欄位，狀態限三選一，
    // 大頭照（base64 data URL）長度設上限，避免超過 Firestore 單筆 1MiB。
    function validStaff() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'empNo', 'name', 'alias', 'email', 'status',
          'address', 'mobile', 'lineId', 'jobTitle', 'loginPassword',
          'birthday', 'passport', 'nationalId', 'note',
          'hireDate', 'leaveDate', 'avatar', 'updatedAt'
        ])
        && (!('status' in d) || d.status in ['active', 'left', 'contract'])
        && (!('avatar' in d) || (d.avatar is string && d.avatar.size() <= 700000))
        && (!('note' in d) || (d.note is string && d.note.size() <= 3000));
    }

    // 公開小卡寫入驗證（profiles）：只放非敏感的同步欄位。
    // hireDate（入職日期）為非敏感欄位，同步給本人計算「生存天數」。
    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'alias', 'avatar', 'jobTitle', 'hireDate', 'updatedAt'])
        && (!('avatar' in d) || (d.avatar is string && d.avatar.size() <= 700000))
        && (!('hireDate' in d) || (d.hireDate is string && d.hireDate.size() <= 10));
    }

    // 公告寫入驗證（最新消息）：標題 / 內容 / 類型 / 圖片(1:1, base64) / 日期。
    // 圖片統一壓縮以加快傳輸，長度設上限避免超過單筆 1MiB。
    function validAnnouncement() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'body', 'type', 'image', 'images', 'date', 'createdAt'])
        && validStr(d.title, 150)
        && (!('body' in d) || (d.body is string && d.body.size() <= 8000))
        && (!('type' in d) || (d.type in ['share', 'project', 'hr', 'event', 'system', 'important']))
        && (!('image' in d) || (d.image is string && d.image.size() <= 800000))
        && (!('images' in d) || (d.images is list && d.images.size() <= 8))
        && (!('date' in d) || (d.date is string && d.date.size() <= 10))
        && d.createdAt == request.time;
    }

    // 專案內容寫入驗證：標題 / 簡述 / 連結 / 縮圖(小, base64) /
    // 作品類型(BL,BG) / 製作狀態 / 年份。
    function validProject() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'desc', 'url', 'thumb', 'kind', 'status', 'year', 'createdAt'])
        && validStr(d.title, 100)
        && (!('desc' in d) || (d.desc is string && d.desc.size() <= 500))
        && (!('url' in d) || (d.url is string && d.url.size() <= 2000 && (d.url.size() == 0 || d.url.matches('https?://.*'))))
        && (!('thumb' in d) || (d.thumb is string && d.thumb.size() <= 200000))
        && (!('kind' in d) || (d.kind in ['BL', 'BG', '']))
        && (!('status' in d) || (d.status in ['planning', 'producing', 'done']))
        && (!('year' in d) || (d.year is string && d.year.size() <= 10))
        && d.createdAt == request.time;
    }

    // 文件下載寫入驗證：文件類型 / 標題 / 內容說明 / 連結。
    function validDocument() {
      let d = request.resource.data;
      return d.keys().hasOnly(['docType', 'title', 'desc', 'url', 'createdAt'])
        && validStr(d.title, 150)
        && (!('docType' in d) || (d.docType is string && d.docType.size() <= 30))
        && (!('desc' in d) || (d.desc is string && d.desc.size() <= 2000))
        && (!('url' in d) || (d.url is string && d.url.size() <= 2000 && (d.url.size() == 0 || d.url.matches('https?://.*'))))
        && d.createdAt == request.time;
    }

    // APP 寫入驗證：icon(小, base64) / 名稱 / 簡述 / 使用說明 / 下載連結 /
    // images(內文 1:1 相簿，base64 陣列；單筆文件上限 1MiB 由 Firestore 強制)。
    function validApp() {
      let d = request.resource.data;
      return d.keys().hasOnly(['icon', 'name', 'desc', 'usage', 'downloadUrl', 'images', 'createdAt'])
        && validStr(d.name, 80)
        && (!('icon' in d) || (d.icon is string && d.icon.size() <= 200000))
        && (!('desc' in d) || (d.desc is string && d.desc.size() <= 500))
        && (!('usage' in d) || (d.usage is string && d.usage.size() <= 8000))
        && (!('images' in d) || (d.images is list && d.images.size() <= 8))
        && (!('downloadUrl' in d) || (d.downloadUrl is string && d.downloadUrl.size() <= 2000 && (d.downloadUrl.size() == 0 || d.downloadUrl.matches('https?://.*'))))
        && d.createdAt == request.time;
    }

    // 公告：登入成員可讀；只有管理員可新增（須通過內容驗證）、修改、刪除
    // Only deliberately published website posts belong here. Internal announcements stay private.
    function validPublicAnnouncement() {
      let d = request.resource.data;
      return d.keys().hasAll(['title','body','category','date','url','image','createdAt','updatedAt'])
        && d.keys().hasOnly(['title','body','category','date','url','image','createdAt','updatedAt'])
        && validStr(d.title,150) && d.body is string && d.body.size() <= 6000
        && d.category in ['event','shop','class']
        && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.url is string && d.url.size() <= 500
        && (d.url == '' || d.url.matches('https://www[.]instagram[.]com/(p|reel)/[A-Za-z0-9_-]+/'))
        && d.image is string && d.image.size() <= 650000
        && (d.image == '' || d.image.matches('data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+'))
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /publicAnnouncements/{id} {
      allow read: if true;
      allow create: if isAdmin() && validPublicAnnouncement() && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validPublicAnnouncement() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /announcements/{id} {
      allow read:           if isSignedIn();
      allow create:         if isAdmin() && validAnnouncement();
      allow update, delete: if isAdmin();
    }

    // 快速連結（舊版，保留相容）：登入成員可讀；只有管理員可寫
    match /links/{id} {
      allow read:           if isSignedIn();
      allow create:         if isAdmin() && validLink();
      allow update, delete: if isAdmin();
    }

    // 專案內容：登入成員可讀；只有管理員可寫（須通過內容驗證）
    match /projects/{id} {
      allow read:           if isSignedIn();
      allow create:         if isAdmin() && validProject();
      allow update, delete: if isAdmin();
    }

    // 文件下載：登入成員可讀；只有管理員可寫（須通過內容驗證）
    match /documents/{id} {
      allow read:           if isSignedIn();
      allow create:         if isAdmin() && validDocument();
      allow update, delete: if isAdmin();
    }

    // APP：登入成員可讀；只有管理員可寫（須通過內容驗證）
    match /apps/{id} {
      allow read:           if isSignedIn();
      allow create:         if isAdmin() && validApp();
      allow update, delete: if isAdmin();
    }

    // 管理員名單：登入成員可讀（前端用來判斷要不要顯示編輯介面）；
    // 不開放任何前端寫入，只能在 Console 手動管理。
    match /admins/{uid} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // 員工完整資料（含密碼、身分證、護照、備註等敏感欄位）：
    // 文件 ID = 員工 email（小寫）。只有管理員能讀寫，員工本人也讀不到。
    match /staff/{id} {
      allow read:           if isAdmin();
      allow create, update: if isAdmin() && validStaff();
      allow delete:         if isAdmin();
    }

    // 員工公開小卡：文件 ID = 員工 email（小寫）。
    // 管理員可讀寫所有人；員工本人只能讀自己這一筆（用於同步姓名/代稱/大頭照），不可寫。
    match /profiles/{id} {
      allow read:           if isAdmin()
                              || (isSignedIn() && request.auth.token.email.lower() == id);
      allow create, update: if isAdmin() && validProfile();
      allow delete:         if isAdmin();
    }

    // 員工表單：欄位發布後固定；管理員可開關收件。
    function validFormField(f) {
      return f is map && f.keys().hasOnly(['label', 'type', 'required', 'options'])
        && validStr(f.label, 100) && f.type in ['text', 'number', 'select']
        && f.required is bool && f.options is list && f.options.size() <= 20
        && (f.type != 'select' || f.options.size() > 0);
    }
    function validFieldAt(fields, i) {
      return fields.size() <= i || validFormField(fields[i]);
    }
    function validForm() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'description', 'fields', 'open', 'createdAt'])
        && validStr(d.title, 100) && d.description is string && d.description.size() <= 2000
        && d.open is bool && d.createdAt == request.time
        && d.fields is list && d.fields.size() > 0 && d.fields.size() <= 20
        && validFieldAt(d.fields, 0)
        && validFieldAt(d.fields, 1)
        && validFieldAt(d.fields, 2)
        && validFieldAt(d.fields, 3)
        && validFieldAt(d.fields, 4)
        && validFieldAt(d.fields, 5)
        && validFieldAt(d.fields, 6)
        && validFieldAt(d.fields, 7)
        && validFieldAt(d.fields, 8)
        && validFieldAt(d.fields, 9)
        && validFieldAt(d.fields, 10)
        && validFieldAt(d.fields, 11)
        && validFieldAt(d.fields, 12)
        && validFieldAt(d.fields, 13)
        && validFieldAt(d.fields, 14)
        && validFieldAt(d.fields, 15)
        && validFieldAt(d.fields, 16)
        && validFieldAt(d.fields, 17)
        && validFieldAt(d.fields, 18)
        && validFieldAt(d.fields, 19);
    }
    function uniformFields() {
      return [
        {'type':'number','required':true}, {'type':'number','required':true},
        {'type':'number','required':true}, {'type':'number','required':true},
        {'type':'number','required':true}, {'type':'number','required':true},
        {'type':'select','required':true,'options':['輕量','一般','厚重','無偏好']},
        {'type':'text','required':true}
      ];
    }
    function validAnswerAt(fields, answers, i) {
      return fields.size() <= i || (
        (!fields[i].required && answers[i] == '')
        || (fields[i].type == 'text' && validStr(answers[i], 200))
        || (fields[i].type == 'number' && answers[i] is number && answers[i] >= 0.1 && answers[i] <= 1000)
        || (fields[i].type == 'select' && answers[i] is string && answers[i] in fields[i].options)
      );
    }
    function validFormResponse(id) {
      let stored = exists(/databases/$(database)/documents/forms/$(id));
      let fields = stored ? get(/databases/$(database)/documents/forms/$(id)).data.fields : uniformFields();
      let d = request.resource.data;
      return (stored || id == 'uniform-sizes')
        && (!stored || get(/databases/$(database)/documents/forms/$(id)).data.open == true)
        && d.keys().hasOnly(['answers','email','updatedAt'])
        && d.email == request.auth.token.email && d.updatedAt == request.time
        && d.answers is list && d.answers.size() == fields.size()
        && validAnswerAt(fields, d.answers, 0)
        && validAnswerAt(fields, d.answers, 1)
        && validAnswerAt(fields, d.answers, 2)
        && validAnswerAt(fields, d.answers, 3)
        && validAnswerAt(fields, d.answers, 4)
        && validAnswerAt(fields, d.answers, 5)
        && validAnswerAt(fields, d.answers, 6)
        && validAnswerAt(fields, d.answers, 7)
        && validAnswerAt(fields, d.answers, 8)
        && validAnswerAt(fields, d.answers, 9)
        && validAnswerAt(fields, d.answers, 10)
        && validAnswerAt(fields, d.answers, 11)
        && validAnswerAt(fields, d.answers, 12)
        && validAnswerAt(fields, d.answers, 13)
        && validAnswerAt(fields, d.answers, 14)
        && validAnswerAt(fields, d.answers, 15)
        && validAnswerAt(fields, d.answers, 16)
        && validAnswerAt(fields, d.answers, 17)
        && validAnswerAt(fields, d.answers, 18)
        && validAnswerAt(fields, d.answers, 19);
    }
    match /forms/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && validForm()
        && (id != 'uniform-sizes' || request.resource.data.fields == [
          {'label':'身高（cm）','type':'number','required':true,'options':[]},
          {'label':'體重（kg）','type':'number','required':true,'options':[]},
          {'label':'肩寬（cm）','type':'number','required':true,'options':[]},
          {'label':'胸圍（cm）','type':'number','required':true,'options':[]},
          {'label':'衣長（cm）','type':'number','required':true,'options':[]},
          {'label':'袖長（cm）','type':'number','required':true,'options':[]},
          {'label':'衣服重量類型','type':'select','required':true,'options':['輕量','一般','厚重','無偏好']},
          {'label':'想印在衣服背後的名字','type':'text','required':true,'options':[]}
        ]);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open'])
        && request.resource.data.open is bool;
      allow delete: if false;
      match /responses/{uid} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow create, update: if isSignedIn() && request.auth.uid == uid && validFormResponse(id);
        allow delete: if false;
      }
    }

    // 其他一切預設拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
